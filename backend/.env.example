# LLM providers, tried in order: Groq -> NVIDIA Build -> OpenRouter. Groq and NVIDIA Build
# each give a DEDICATED per-account free quota (no card needed for either) — tried first
# since OpenRouter's :free tier is a POOL SHARED with every other user of that model, and
# was confirmed congested during testing on 2026-08-15 (429s + silent timeouts across
# multiple models/accounts). A provider left blank here is skipped, not attempted.

# Groq: console.groq.com — no card, 30 RPM / 6,000 TPM / 14,400 RPD, dedicated per account.
# Larger model first, deliberately — the smaller/faster llama-3.1-8b-instant always
# returns a syntactically valid response, so the chain never reached the larger model,
# but its actual claims were frequently imprecise (Figure Checker rejections, not
# infrastructure failures). Groq is fast enough that the bigger model first is still fast.
GROQ_API_KEY=
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# NVIDIA Build: build.nvidia.com — no card, ~1,000 free credits then rate-limited (~40 RPM)
# continued access on smaller models. Re-verify these slugs against the live catalog.
NVIDIA_API_KEY=
NVIDIA_MODELS=meta/llama-3.1-8b-instruct,nvidia/nemotron-nano-9b-v2

# OpenRouter :free tier — last resort, shared pool, congestion not permanent.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FALLBACKS=nvidia/nemotron-nano-9b-v2:free,google/gemma-4-26b-a4b-it:free,openai/gpt-oss-20b:free,liquid/lfm-2.5-2.6b:free

# LLM_MODEL_TIMEOUT_SECONDS=20
ESP32_BASE_URL=http://192.168.4.1
DATABASE_URL=sqlite:///./tanaw.db

# Real hardware path (confirmed with the hardware engineer): purok devices broadcast
# over ESP-NOW to one gateway device, relayed here over USB serial. Find your gateway's
# COM port in Device Manager (Ports (COM & LPT)) after plugging it in, or run this in
# PowerShell: [System.IO.Ports.SerialPort]::getportnames()
ENABLE_GATEWAY_SERIAL_INGESTION=true
GATEWAY_SERIAL_PORT=COM7
GATEWAY_BAUD_RATE=115200

# Legacy single-ESP32 WiFi-hotspot-and-HTTP path — superseded by the gateway above,
# kept opt-in in case that direction is ever revisited.
ENABLE_LEGACY_WIFI_INGESTION=false

# Numeric thresholds — see 06_scope_and_open_decisions.md. Uncomment to override any default.
# INGESTION_POLL_INTERVAL_SECONDS=1.5
# SEVERITY_SWEEP_INTERVAL_SECONDS=60
# SILENCE_HOURS_WARN=6
# SILENCE_HOURS_CRITICAL=12
# PANIC_PRESS_DISTINCT_BUTTONS=3
# PANIC_PRESS_WINDOW_MINUTES=15
# SEVERITY_HIGH_CUTOFF=60
# SEVERITY_MEDIUM_CUTOFF=30
# CLUSTER_WINDOW_MINUTES=45
# CLUSTER_MIN_PUROKS=2
# ANOMALY_EVENT_COUNT=5
# ANOMALY_WINDOW_SECONDS=60
# STABLE_LUWAS_HOURS=24

# Barangay confirmed: Lambusan, San Remigio, Cebu (real centroid coords below).
# "San Remigio" is the MUNICIPALITY, not a barangay — do not put it here.
# Purok-level placements within Lambusan are still pending real input — see seed_data.py.
# BARANGAY_NAME=Lambusan
# BARANGAY_CENTER_LAT=10.9990
# BARANGAY_CENTER_LNG=123.9311
# REAL_DEVICE_LAT=10.9990
# REAL_DEVICE_LNG=123.9311
